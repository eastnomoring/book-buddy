# 环境变量模板
# 复制为 .env 并填入你的 API Key

# 通义千问 API Key（可选，LLM_PROVIDER=qwen 时必需）
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DeepSeek API Key（可选，如使用 DeepSeek）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI 兼容接口（智谱 GLM / 硅基流动 / Ollama 通用，LLM_PROVIDER=openai 时必需）
# 智谱：在 https://open.bigmodel.cn/ 创建 API Key
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-4v-flash

# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=qwen-vl-max

# RAG 配置
VECTOR_DB_PATH=./data/chroma
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=embedding-3

# 语音配置
ASR_PROVIDER=qwen
TTS_PROVIDER=qwen
TTS_VOICE=longxiaochun

# 应用配置
DEBUG=true