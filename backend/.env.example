# 环境变量模板
# 复制为 .env 并填入你的 API Key

# 通义千问 API Key（可选，LLM_PROVIDER=qwen 时必需）
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI 兼容接口（智谱 GLM / 硅基流动 / Ollama 通用，LLM_PROVIDER=openai 时必需）
# 智谱：在 https://open.bigmodel.cn/ 创建 API Key
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-4.6v
# 免费替代品：glm-4.6v-flash；轻量高速版：glm-4.6v-flashx

# GLM 思考模式（讲解复杂证明时开启，日常问答关闭以降低首字延迟）
OPENAI_THINKING=false

# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=qwen-vl-max

# RAG 配置
VECTOR_DB_PATH=./data/chroma
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=embedding-3

# 语音配置
ASR_PROVIDER=qwen
TTS_PROVIDER=qwen
TTS_VOICE=longxiaochun

# MCP 代码执行（概率模拟 / 画图验证；受限沙箱，默认关闭）
MCP_CODE_ENABLED=false

# Anki 卡片生成（需本地运行 Anki + AnkiConnect 插件码 2055492159，默认关闭）
ANKI_ENABLED=false

# 本地笔记沉淀（markdown 写入 data/notes/，默认开启）
NOTES_ENABLED=true

# 应用配置
DEBUG=true

# API 鉴权（强烈建议：只要部署到非本机环境就必须设置）
# 未设置时所有 /api/* 接口完全开放（仅限本机自用）
# 设置后客户端需在请求头携带 Authorization: Bearer <token>
# AUTH_TOKEN=change_me_to_a_long_random_string
