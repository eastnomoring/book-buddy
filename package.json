{
  "name": "book-buddy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @book-buddy/core build && pnpm --filter @book-buddy/web build && pnpm --filter @book-buddy/mp build:mp-weixin",
    "build:desktop": "pnpm build && pnpm --filter @book-buddy/desktop build",
    "dev:web": "pnpm --filter @book-buddy/web dev",
    "dev:mp": "pnpm --filter @book-buddy/mp dev:mp-weixin",
    "dev:desktop": "pnpm --filter @book-buddy/desktop dev",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn main:app --reload",
    "start": "node scripts/start.mjs",
    "start:dev": "node scripts/start.mjs --dev",
    "start:desktop": "node scripts/start.mjs --desktop",
    "test": "pnpm --filter @book-buddy/core test && cd backend && .venv/bin/python -m pytest tests/ -q",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --cache .",
    "type-check": "pnpm --filter @book-buddy/mp run type-check && pnpm --filter @book-buddy/web exec vue-tsc --noEmit"
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6"
  }
}
